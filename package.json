{
  "name": "ideafresh",
  "version": "1.1.1",
  "private": true,
  "packageManager": "pnpm@11.15.1",
  "scripts": {
    "dev": "next dev --webpack",
    "build": "pnpm generate:rss && next build --webpack",
    "generate:rss": "tsx --tsconfig jsconfig.json scripts/generate-rss.js",
    "serve": "wrangler pages dev out --compatibility-date=2026-10-01",
    "start": "cross-env SOCKET=true node ./data",
    "analyze": "pnpm generate:rss && cross-env ANALYZE=true next build --webpack",
    "lint": "eslint pages components lib layouts scripts server",
    "lint:fix": "eslint pages components lib layouts scripts server --fix",
    "prepare": "husky install"
  },
  "dependencies": {
    "@fontsource/inter": "4.5.2",
    "@mailchimp/mailchimp_marketing": "^3.0.58",
    "@tailwindcss/forms": "^0.5.11",
    "@tailwindcss/typography": "^0.5.0",
    "autoprefixer": "^10.4.0",
    "esbuild": "^0.13.13",
    "github-slugger": "^1.3.0",
    "gray-matter": "^4.0.2",
    "image-size": "1.0.0",
    "lz-string": "~1.5.0",
    "mdx-bundler": "^8.0.0",
    "next": "16.3.8",
    "next-themes": "^0.4.6",
    "postcss": "^8.4.5",
    "preact": "^10.6.2",
    "punycode": "^2.3.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "reading-time": "1.3.0",
    "rehype-autolink-headings": "^6.1.0",
    "rehype-citation": "^2.3.2",
    "rehype-katex": "^6.0.2",
    "rehype-preset-minify": "6.0.0",
    "rehype-prism-plus": "^1.3.2",
    "rehype-slug": "^5.0.0",
    "remark-footnotes": "^4.0.1",
    "remark-gfm": "^3.0.1",
    "remark-math": "^5.1.1",
    "sharp": "^0.30.5",
    "smoothscroll-polyfill": "^0.4.4",
    "tailwindcss": "^3.0.23",
    "unist-util-visit": "^4.0.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@next/bundle-analyzer": "16.3.8",
    "@svgr/webpack": "^6.1.2",
    "@typescript-eslint/parser": "^8.71.0",
    "cross-env": "^7.0.3",
    "dedent": "^0.7.0",
    "eslint": "^9.39.5",
    "eslint-config-next": "16.3.8",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^4.2.5",
    "file-loader": "^6.0.0",
    "globals": "^16.5.0",
    "globby": "11.0.3",
    "husky": "^6.0.0",
    "inquirer": "^8.1.1",
    "lint-staged": "^11.0.0",
    "next-remote-watch": "^1.0.0",
    "prettier": "^2.5.1",
    "prettier-plugin-tailwindcss": "^0.1.4",
    "socket.io": "^4.4.0",
    "socket.io-client": "^4.4.0",
    "tsx": "^4.23.15",
    "wrangler": "^4.147.0"
  },
  "lint-staged": {
    "*.+(js|jsx|ts|tsx)": [
      "eslint --fix"
    ],
    "*.+(js|jsx|ts|tsx|json|css|md|mdx)": [
      "prettier --write"
    ]
  }
}
